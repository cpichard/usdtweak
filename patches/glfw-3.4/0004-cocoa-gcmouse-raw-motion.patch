+
+// Storage for the GCMouse connect/disconnect notification observers,
+// released in _glfwTerminateCocoa.
+static id sGCMouseConnectObserver = nil;
+static id sGCMouseDisconnectObserver = nil;
+static GLFWbool sGCMouseInitialized = GLFW_FALSE;
 
+
+// Install the mouseMovedHandler on a GCMouse instance.  The block
+// delivers unaccelerated deltas (raw HID values) into the disabled-
+// cursor window's virtualCursorPos.  GameController's mouse Y is
+// positive-up; GLFW's Y is positive-down — invert deltaY.
+static void installGCMouseHandler(id mouse) API_AVAILABLE(macos(11.0))
+{
+    if (!mouse)
+        return;
+
+    GCMouseInput *input = ((GCMouse *)mouse).mouseInput;
+    if (!input)
+        return;
+
+    input.mouseMovedHandler = ^(GCMouseInput *_input, float dx, float dy) {
+        _GLFWwindow *target = _glfw.ns.disabledCursorWindow;
+        if (!target || !target->rawMouseMotion)
+            return;
+        if (target->cursorMode != GLFW_CURSOR_DISABLED)
+            return;
+        if (dx == 0.0f && dy == 0.0f)
+            return;
+
+        _glfwInputCursorPos(target,
+                            target->virtualCursorPosX + (double)dx,
+                            target->virtualCursorPosY - (double)dy);
+    };
+}
+
+// Lazy one-shot setup: install the handler on every currently-connected
+// mouse and subscribe to connect/disconnect notifications.  Returns
+// FALSE if GameController is not available (macOS < 11), in which case
+// _glfwRawMouseMotionSupportedCocoa would already return FALSE so we
+// shouldn't be here.
+static GLFWbool initGCMouseObservers(void)
+{
+    if (sGCMouseInitialized)
+        return GLFW_TRUE;
+
+    Class GCMouseClass = NSClassFromString(@"GCMouse");
+    if (!GCMouseClass)
+        return GLFW_FALSE;
+
+    if (@available(macOS 11.0, *))
+    {
+        NSArray *mice = [GCMouseClass valueForKey:@"mice"];
+        for (GCMouse *mouse in mice)
+            installGCMouseHandler(mouse);
+
+        NSNotificationCenter *nc = [NSNotificationCenter defaultCenter];
+        sGCMouseConnectObserver = [nc
+            addObserverForName:@"GCMouseDidConnectNotification"
+                        object:nil
+                         queue:[NSOperationQueue mainQueue]
+                    usingBlock:^(NSNotification *note) {
+                installGCMouseHandler(note.object);
+            }];
+
+        sGCMouseDisconnectObserver = [nc
+            addObserverForName:@"GCMouseDidDisconnectNotification"
+                        object:nil
+                         queue:[NSOperationQueue mainQueue]
+                    usingBlock:^(NSNotification *note) {
+                // Handler is cleared automatically when the GCMouse
+                // instance is released by the framework; no-op here.
+                (void)note;
+            }];
+
+        sGCMouseInitialized = GLFW_TRUE;
+        return GLFW_TRUE;
+    }
+
+    return GLFW_FALSE;
+}
+
 void _glfwSetRawMouseMotionCocoa(_GLFWwindow *window, GLFWbool enabled)
 {
-    _glfwInputError(GLFW_FEATURE_UNIMPLEMENTED,
-                    "Cocoa: Raw mouse motion not yet implemented");
+    (void)window;
+    if (enabled)
+    {
+        if (!initGCMouseObservers())
+        {
+            _glfwInputError(GLFW_PLATFORM_ERROR,
+                "Cocoa: GameController framework unavailable, raw mouse "
+                "motion will fall back to the accelerated NSEvent path");
+        }
+    }
+    // No teardown on disable — observers are cheap to keep around, and
+    // the per-window rawMouseMotion flag gates whether GCMouse deltas
+    // are consumed in installGCMouseHandler's block.
 }
 
 GLFWbool _glfwRawMouseMotionSupportedCocoa(void)
 {
-    return GLFW_FALSE;
+    // Requires macOS 11+ (GCMouse).  NSClassFromString check makes this
+    // a runtime test rather than a build-time one, so a binary linked
+    // against macOS 11+ still answers GLFW_FALSE if loaded on 10.x.
+    return NSClassFromString(@"GCMouse") ? GLFW_TRUE : GLFW_FALSE;
+}
+
+// Called from _glfwTerminateCocoa to release the notification observers
+// installed by initGCMouseObservers().
+void _glfwReleaseGCMouseObserversCocoa(void)
+{
+    if (sGCMouseConnectObserver)
+    {
+        [[NSNotificationCenter defaultCenter] removeObserver:sGCMouseConnectObserver];
+        sGCMouseConnectObserver = nil;
+    }
+    if (sGCMouseDisconnectObserver)
+    {
+        [[NSNotificationCenter defaultCenter] removeObserver:sGCMouseDisconnectObserver];
+        sGCMouseDisconnectObserver = nil;
+    }
+    sGCMouseInitialized = GLFW_FALSE;
 }
 
