+// GCMouse-based raw mouse motion (macOS 11+).  Provides unaccelerated
+// mouse deltas for both regular mice and trackpads, where neither the
+// NSEvent path nor IOHIDManager nor kCGMouseEventDeltaX can — those all
+// receive deltas after macOS pointer acceleration has been applied (in
+// the case of trackpads, acceleration is applied below the CGEvent
+// layer entirely).  The GameController framework was extended in
+// macOS 11 specifically to provide game-style relative mouse input,
+// and SDL3 uses the same API path (Cocoa_SetGCMouseRelativeMode).
+//
+// Linked weakly so a binary built on macOS 11+ still loads on macOS 10.x;
+// at runtime we check NSClassFromString(@"GCMouse") and silently
+// degrade to the accelerated NSEvent path if the framework isn't
+// available.
+#import <GameController/GameController.h>
+
 // HACK: This enum value is missing from framework headers on OS X 10.11 despite
 //       having been (according to documentation) added in Mac OS X 10.7
 #define NSWindowCollectionBehaviorFullScreenNone (1 << 9)
@@ -447,6 +462,12 @@
 {
     if (window->cursorMode == GLFW_CURSOR_DISABLED)
     {
+        // When raw mouse motion is enabled, deltas are delivered by the
+        // GCMouse mouseMovedHandler installed in installGCMouseHandler().
+        // Skip the accelerated NSEvent path so we don't double-count motion.
+        if (window->rawMouseMotion)
+            return;
+
         const double dx = [event deltaX] - window->ns.cursorWarpDeltaX;
         const double dy = [event deltaY] - window->ns.cursorWarpDeltaY;
 
