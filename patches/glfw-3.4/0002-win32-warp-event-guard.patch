From: usdtweak <noreply@example.com>
Subject: [PATCH 2/2] win32: add warpCursorPos guard to skip warp's own motion event

Mirrors the warpCursorPos pattern that x11_window.c already uses:
when GLFW warps the cursor (via SetCursorPos in disabled-cursor mode),
record the warp target on the window struct.  When WM_MOUSEMOVE or
WM_INPUT (MOUSE_MOVE_ABSOLUTE branch) delivers an event whose
coordinates exactly match the warp target, skip the cursor-position
update — but still advance lastCursorPosX/Y so subsequent events
compute their delta from the warp target rather than from a stale
pre-warp position.

Previously, _glfwSetCursorPosWin32 updated lastCursorPosX/Y directly
to the warp target.  When stale WM_MOUSEMOVE messages (queued by the
OS before the warp completed) were then delivered, they computed
"dx = staleX - lastCursorPosX" against post-warp lastCursorPosX, which
manifested as a one-shot giant delta on the first event after entering
disabled mode (or after the periodic re-center in _glfwPollEventsWin32).

This is the upstream fix for the family of issues #1523, #2523, #1269,
#759, #193.  The X11 path already uses this pattern (see
x11_window.c, MotionNotify case); this patch promotes it to Win32.

WARP_CURSOR_POS init: a new int field on _GLFWwindowWin32, initialized
to INT_MIN in _glfwCreateWindowWin32 (since calloc-zero would coincide
with the valid coordinate (0, 0)).  The guard resets it to INT_MIN
after consumption so a subsequent stale event with non-warp coordinates
falls through to the normal delta-computation path.

--- a/src/win32_platform.h
+++ b/src/win32_platform.h
@@ -431,6 +431,11 @@

     // The last received cursor position, regardless of source
     int                 lastCursorPosX, lastCursorPosY;
+    // The most recent cursor position passed to SetCursorPos.  Used to
+    // recognize and skip the WM_MOUSEMOVE event generated by the warp,
+    // mirroring the warpCursorPos guard in x11_window.c.  INT_MIN means
+    // "no warp pending".
+    int                 warpCursorPosX, warpCursorPosY;
     // The last received high surrogate when decoding pairs of UTF-16 messages
     WCHAR               highSurrogate;
 } _GLFWwindowWin32;
--- a/src/win32_window.c
+++ b/src/win32_window.c
@@ -875,14 +875,31 @@

             if (window->cursorMode == GLFW_CURSOR_DISABLED)
             {
-                const int dx = x - window->win32.lastCursorPosX;
-                const int dy = y - window->win32.lastCursorPosY;
-
                 if (_glfw.win32.disabledCursorWindow != window)
                     break;
                 if (window->rawMouseMotion)
                     break;
+
+                // Skip the motion event generated by our own warp.  This
+                // mirrors the warpCursorPos guard in x11_window.c and is
+                // the fix for GLFW #1523 / #2523: stale WM_MOUSEMOVE
+                // messages queued before the warp would otherwise compute
+                // a giant delta against the post-warp lastCursorPos.
+                // We still update lastCursorPos so the next motion event
+                // computes its delta from the warp target.
+                if (x == window->win32.warpCursorPosX &&
+                    y == window->win32.warpCursorPosY)
+                {
+                    window->win32.warpCursorPosX = INT_MIN;
+                    window->win32.warpCursorPosY = INT_MIN;
+                    window->win32.lastCursorPosX = x;
+                    window->win32.lastCursorPosY = y;
+                    return 0;
+                }

+                const int dx = x - window->win32.lastCursorPosX;
+                const int dy = y - window->win32.lastCursorPosY;
+
                 _glfwInputCursorPos(window,
                                     window->virtualCursorPosX + dx,
                                     window->virtualCursorPosY + dy);
@@ -949,6 +966,18 @@
                 pos.y += (int) ((data->data.mouse.lLastY / 65535.f) * height);
                 ScreenToClient(window->win32.handle, &pos);

+                // Skip the motion event generated by our own warp.  See
+                // the corresponding comment in WM_MOUSEMOVE above.
+                if (pos.x == window->win32.warpCursorPosX &&
+                    pos.y == window->win32.warpCursorPosY)
+                {
+                    window->win32.warpCursorPosX = INT_MIN;
+                    window->win32.warpCursorPosY = INT_MIN;
+                    window->win32.lastCursorPosX = pos.x;
+                    window->win32.lastCursorPosY = pos.y;
+                    break;
+                }
+
                 dx = pos.x - window->win32.lastCursorPosX;
                 dy = pos.y - window->win32.lastCursorPosY;
             }
@@ -1496,6 +1525,13 @@
                                 const _GLFWctxconfig* ctxconfig,
                                 const _GLFWfbconfig* fbconfig)
 {
+    // Sentinel: no warp pending.  Used by the WM_MOUSEMOVE and WM_INPUT
+    // handlers below to recognize and skip the motion event generated by
+    // _glfwSetCursorPosWin32 (which is what disabled-cursor mode uses to
+    // re-center the cursor each poll).
+    window->win32.warpCursorPosX = INT_MIN;
+    window->win32.warpCursorPosY = INT_MIN;
+
     if (!createNativeWindow(window, wndconfig, fbconfig))
         return GLFW_FALSE;

@@ -2219,9 +2255,14 @@
 {
     POINT pos = { (int) xpos, (int) ypos };

-    // Store the new position so it can be recognized later
-    window->win32.lastCursorPosX = pos.x;
-    window->win32.lastCursorPosY = pos.y;
+    // Record the warp target so WM_MOUSEMOVE/WM_INPUT can recognize and
+    // skip the motion event generated by SetCursorPos.  This mirrors the
+    // warpCursorPos guard in x11_window.c and fixes GLFW #1523 / #2523:
+    // previously, this function updated lastCursorPosX/Y directly to the
+    // warp target, which made stale WM_MOUSEMOVE messages queued before
+    // the warp compute "dx = staleX - warpedX" — a one-shot giant delta.
+    window->win32.warpCursorPosX = pos.x;
+    window->win32.warpCursorPosY = pos.y;

     ClientToScreen(window->win32.handle, &pos);
     SetCursorPos(pos.x, pos.y);
